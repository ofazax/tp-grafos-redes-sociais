@startuml casos_de_uso
left to right direction
skinparam packageStyle rectangle

actor "Usuário\n(analista)" as U
actor "Bases de dados\n(SNAP, CSV)" as B <<sistema externo>>

rectangle "Ferramenta de Análise de Redes Sociais" {
  usecase "UC01 Obter grafo" as UC01
  usecase "UC02 Carregar base real" as UC02
  usecase "UC03 Gerar grafo sintético" as UC03
  usecase "UC04 Visualizar rede" as UC04
  usecase "UC05 Colorir por métrica\nou comunidade" as UC05
  usecase "UC06 Calcular métricas" as UC06
  usecase "UC07 Analisar grau\ne densidade" as UC07
  usecase "UC08 Analisar caminhos\ne conectividade" as UC08
  usecase "UC09 Calcular centralidades" as UC09
  usecase "UC10 Calcular agrupamento" as UC10
  usecase "UC11 Detectar comunidades" as UC11
  usecase "UC12 Calcular modularidade" as UC12
  usecase "UC13 Avaliar contra\npartição real (NMI/ARI)" as UC13
  usecase "UC14 Identificar influenciadores" as UC14
  usecase "UC15 Simular propagação SIR" as UC15
  usecase "UC16 Ver resultados" as UC16
  usecase "UC17 Exportar resultados (JSON)" as UC17
}

U --> UC01
U --> UC04
U --> UC06
U --> UC11
U --> UC14
U --> UC16
UC02 --> B

UC02 --|> UC01
UC03 --|> UC01
UC07 --|> UC06
UC08 --|> UC06
UC09 --|> UC06
UC10 --|> UC06

UC05 ..> UC04 : <<extend>>
UC11 ..> UC12 : <<include>>
UC13 ..> UC11 : <<extend>>
UC14 ..> UC09 : <<include>>
UC14 ..> UC15 : <<include>>
UC17 ..> UC16 : <<extend>>

note right of UC13
  Só quando a base tem
  comunidades reais
  (ex.: facções do Karate)
end note
@enduml
